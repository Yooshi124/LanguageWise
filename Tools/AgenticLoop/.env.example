# =============================================================================
# Agentic Loop — configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# =============================================================================

# --- Required -----------------------------------------------------------------
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models -------------------------------------------------------------------
# Main model used for analysis and planning.
GEMINI_MODEL=gemini-3.7-flash

# Optional overrides. Leave blank to fall back to GEMINI_MODEL.
GEMINI_SELECTION_MODEL=
GEMINI_REVIEW_MODEL=

# Set to false to skip the critic (Review Agent) pass — faster and cheaper.
ENABLE_REVIEW_AGENT=true

# --- Review scope -------------------------------------------------------------
# Repository to review. Leave blank to auto-detect (two levels up from this tool).
REPO_ROOT=

# Restrict the review to one directory and its children.
# Leave blank to review the whole repository.
# Example: C:\Users\justi\source\repos\LanguageWise\DatabaseService
TARGETED_DIRECTORY=

# Comma-separated directory names skipped while scanning.
IGNORE_DIRS=.git,node_modules,.venv,venv,env,__pycache__,bin,obj,dist,build,out,target,.vs,.idea,.pytest_cache,.mypy_cache,coverage,htmlcov,Sessions,Plans

# Comma-separated file extensions to scan. Leave blank for the built-in default set.
INCLUDE_EXTENSIONS=

# --- Context budget -----------------------------------------------------------
# Maximum bytes read from a single file (larger files are truncated with a marker).
MAX_FILE_BYTES=200000

# Maximum number of files sent to the model in one round.
MAX_FILES_IN_CONTEXT=40

# Maximum total bytes of source code sent to the model in one round.
MAX_TOTAL_CONTEXT_BYTES=1500000

# --- Output -------------------------------------------------------------------
# Directories (relative to this tool, or absolute) for generated artefacts.
SESSIONS_DIR=Sessions
PLANS_DIR=Plans

# --- Model output budget ------------------------------------------------------
# Caps the reply, including the model's internal thinking. Raise it if findings
# come back empty or the loop reports a truncated reply.
MAX_OUTPUT_TOKENS=32000
# minimal | low | medium | high, or 'default' to leave it to the model.
THINKING_LEVEL=low

# --- Resilience / logging -----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=180
MAX_RETRIES=3
LOG_LEVEL=INFO
