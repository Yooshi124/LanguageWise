# =============================================================================
# LanguageWise — version control exclusions
# =============================================================================

# ---- .NET ----
[Bb]in/
[Oo]bj/
*.user
*.suo
TestResults/
artifacts/

# ---- SQLite ----
# WARNING: git sets core.ignorecase=true on Windows and macOS, which makes these
# patterns match case-insensitively. Without the negation below, "*.db" also
# matches project DIRECTORIES such as LanguageWise.Shared.Db, silently excluding
# every database microservice from the repository and breaking CI with
# "MSB1009: Project file does not exist". Do not remove the negation.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
!*.Db/

# ---- Node ----
node_modules/
dist/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- Secrets — never commit ----
.env
*.pem
*.key

# ---- Agentic Loop generated artefacts ----
tools/agentic-loop/Sessions/*.md
tools/agentic-loop/Plans/*.md
tools/agentic-loop/output/

# ---- IDE ----
.vs/
.idea/
.vscode/

# ---- OS ----
Thumbs.db
.DS_Store
