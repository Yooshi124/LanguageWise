<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>LanguageWise.QuestsAchievementsNotificationsService.Db</RootNamespace>
    <AssemblyName>LanguageWise.QuestsAchievementsNotificationsService.Db</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sql/**/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
