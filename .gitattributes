# Git stores every text file with LF. Working trees use the platform's native
# endings, so Windows checkouts are CRLF and Linux/macOS checkouts are LF.
* text=auto

# Windows-only scripts are CRLF everywhere, including on CI.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Visual Studio insists on CRLF here.
*.sln text eol=crlf

# Anything Linux containers execute or parse must stay LF, on every platform.
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
*.conf text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
