# Copy this file to .env and replace the placeholder with an OpenRouter API key.
# The .env file is ignored by Git and must never be committed.
OpenRouter__ApiKey=replace-with-your-openrouter-api-key

# Optional overrides:
# OpenRouter__Model=google/gemma-4-26b-a4b-it
# OpenRouter__BaseUrl=https://openrouter.ai/api/v1/
# OpenRouter__MaxOutputTokens=1024
