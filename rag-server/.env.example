# Copy to .env and adjust as needed.

# Host/port the FastMCP HTTP server binds to.
# Containers reach this through host.docker.internal:RAG_PORT.
RAG_HOST=0.0.0.0
RAG_PORT=8100

# Directory the ChromaDB persistent store lives in (relative to rag-server/).
RAG_CHROMA_DIR=.chroma

# Directory holding the corpus of service README-esque markdown files.
RAG_CORPUS_DIR=corpus

# Chroma collection name.
RAG_COLLECTION=languagewise-docs

# Key file guarding POST /query/technical (generated on first start if missing).
# The agentic loop reads the same file by default.
RAG_TECHNICAL_KEY_PATH=.rag-technical-key
