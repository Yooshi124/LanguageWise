# =============================================================================
# Agentic Loop — configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# =============================================================================

# --- Required -----------------------------------------------------------------
# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Models -------------------------------------------------------------------
# Main model used for analysis and planning (OpenRouter model id).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Optional override for file selection. Leave blank to fall back to OPENROUTER_MODEL.
OPENROUTER_SELECTION_MODEL=

# OpenRouter API base URL. Only change this for a compatible proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub Actions integration -----------------------------------------------
# Used by `python main.py --ci-failures` and the /ci-failures command to pull
# failing workflow runs and test logs from GitHub.
# Personal access token (optional for public repos, but recommended for rate
# limits; required for private repos): https://github.com/settings/tokens
GITHUB_TOKEN=

# Repository as owner/name. Leave blank to auto-detect from `git remote get-url origin`.
GITHUB_REPO=

# Workflow file or name to inspect (e.g. student-3.yml). Leave blank to use the
# most recent failed run of any workflow.
GITHUB_WORKFLOW=

# --- RAG integration ------------------------------------------------------------
# Used by `python main.py --rag-validate` and the /rag-validate, /rag commands to
# retrieve documentation context from the local RAG server (rag-server/). The RAG
# server runs locally and is not containerised; start it separately with
# `python server.py` from the rag-server directory.
RAG_BASE_URL=http://localhost:8100
RAG_REQUEST_TIMEOUT_SECONDS=10
RAG_DEFAULT_N_RESULTS=5
# The loop queries POST /query/technical, which also returns TECHNICAL- passages
# (service internals). Its key is read from RAG_TECHNICAL_KEY, or else from the
# file the RAG server generates on first start (default rag-server/.rag-technical-key).
RAG_TECHNICAL_KEY=
RAG_TECHNICAL_KEY_PATH=

# --- MCP integration ------------------------------------------------------------
# Used by `python main.py --mcp-validate` and the /mcp-validate, /mcp commands to
# exercise the shared local MCP server (mcp-server/). The MCP server runs locally
# and is not containerised; start it separately with `dotnet run` from
# mcp-server/src/LanguageWise.McpServer.
MCP_BASE_URL=http://localhost:8200

# Shared MCP API key. Leave blank to read it from the same key file the server
# uses (mcp-server/.mcp-api-key, generated by mcp-server/scripts/New-McpApiKey.ps1).
# Override the file location with MCP_API_KEY_PATH if it lives elsewhere.
MCP_API_KEY=
MCP_API_KEY_PATH=

# Tool scope to validate, e.g. courses | games | chat | quests | leaderboard.
# Only tools named <scope>_* are listed or callable under a scope.
MCP_TOOL_SCOPE=courses

# Optional user JWT forwarded to the MCP server (X-LanguageWise-User-Token) so
# per-user tools can run. Blank means tools that need a signed-in user will
# return their "signed in" error, which is still a valid validation outcome.
MCP_USER_TOKEN=

MCP_REQUEST_TIMEOUT_SECONDS=30

# --- Review Agent (mandatory, local via Ollama) --------------------------------
# The Review Agent always runs and cannot be disabled: every finding from the
# implementation agent (OpenRouter, above) is checked by this separate, local model
# before a human ever sees it. It requires Ollama running on this machine:
#   1. Install Ollama:        https://ollama.com
#   2. Pull the review model: ollama pull gemma4:e2b
#   3. Ollama should already be listening on OLLAMA_HOST by default.
OLLAMA_HOST=http://localhost:11434
OLLAMA_REVIEW_MODEL=gemma4:e2b
OLLAMA_REQUEST_TIMEOUT_SECONDS=600

# How long Ollama keeps the review model loaded in RAM after a call (Ollama's
# own "keep_alive" param, e.g. 30s, 5m, 0 to unload immediately, -1 to keep
# forever). Short values stop the model piling up in memory alongside
# rag-server/mcp-server across a long review session.
OLLAMA_KEEP_ALIVE=30s

# --- Review scope -------------------------------------------------------------
# Repository to review. Leave blank to auto-detect (two levels up from this tool).
REPO_ROOT=

# Restrict the review to one directory and its children.
# Leave blank to review the whole repository.
# Example: C:\Users\justi\source\repos\LanguageWise\DatabaseService
TARGETED_DIRECTORY=

# Comma-separated directory names skipped while scanning.
IGNORE_DIRS=.git,node_modules,.venv,venv,env,__pycache__,bin,obj,dist,build,out,target,.vs,.idea,.pytest_cache,.mypy_cache,coverage,htmlcov,Sessions,Plans

# Comma-separated file extensions to scan. Leave blank for the built-in default set.
INCLUDE_EXTENSIONS=

# --- Context budget -----------------------------------------------------------
# Maximum bytes read from a single file (larger files are truncated with a marker).
MAX_FILE_BYTES=200000

# Maximum number of files sent to the model in one round.
MAX_FILES_IN_CONTEXT=40

# Maximum total bytes of source code sent to the model in one round.
MAX_TOTAL_CONTEXT_BYTES=1500000

# --- Output -------------------------------------------------------------------
# Directories (relative to this tool, or absolute) for generated artefacts.
SESSIONS_DIR=Sessions
PLANS_DIR=Plans

# --- Model output budget ------------------------------------------------------
# Caps the reply, including the model's internal thinking. Raise it if findings
# come back empty or the loop reports a truncated reply.
MAX_OUTPUT_TOKENS=32000
# minimal | low | medium | high, or 'default' to leave it to the model.
# Mapped to OpenRouter's unified `reasoning.effort` parameter.
THINKING_LEVEL=low

# --- Resilience / logging -----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=180
MAX_RETRIES=3
LOG_LEVEL=INFO
