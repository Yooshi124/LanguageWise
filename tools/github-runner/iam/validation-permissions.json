{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLanguageWiseClusterMetadata",
      "Effect": "Allow",
      "Action": "ecs:DescribeClusters",
      "Resource": "arn:aws:ecs:ap-southeast-2:047754151573:cluster/languagewise",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLanguageWiseRepositoryMetadata",
      "Effect": "Allow",
      "Action": "ecr:DescribeRepositories",
      "Resource": "arn:aws:ecr:ap-southeast-2:047754151573:repository/41026release2/languagewise",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}